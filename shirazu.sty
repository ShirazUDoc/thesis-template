%% سایز عنوان فهرست ها
\newcommand{\shirazu@listfront}[2]{
    \csdef{cft#1titlefont}{\hfil\bfseries}
    \csdef{cftafter#1title}{\vspace{\baselineskip}}
    \setlength{\csname cftafter#1titleskip\endcsname}{0pt}
    \setlength{\csname cftbefore#1titleskip\endcsname}{-1.55em}
    \addtocontents{#1}{\textbf{عنوان}\hfill\textbf{صفحه}#2\par}
}
\shirazu@listfront{toc}{}
\shirazu@listfront{lot}{\vspace{0.5\baselineskip}}
