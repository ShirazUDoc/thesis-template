\newcommand{\PrintLatinExaminers}{\shirazu@printpeople{Latin}{Examiner}{Internal Examiner}}
\newcommand{\PrintPersianExternalExaminers}{\shirazu@printpeople{Persian}{ExternalExaminer}{داور خارج از دانشگاه}}
\newcommand{\PrintLatinExternalExaminers}{\shirazu@printpeople{Latin}{ExternalExaminer}{External Examiner}}

