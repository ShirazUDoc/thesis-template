\newcommand{\SpineSep}{\hspace{1cm}}
\newcommand{\SpineLength}{20.5cm}
\newcommand{\shirazu@spine}[1]{\textbf{{\PersianThesisType} {\PersianDegree} \SpineSep {#1} \SpineSep {\PersianStudentName} \SpineSep {\PersianThesisYear} \SpineSep {\PersianUniversity}}}
\newcommand{\PrintSpine}{
    \settowidth{\shirazu@rest}{\shirazu@spine{}}
    \setlength{\shirazu@titlespace}{\dimexpr \SpineLength - \shirazu@rest\relax}
    \ifdim\shirazu@titlespace<1cm \setlength{\shirazu@titlespace}{1cm}\fi
    \typeout{TITLESPACE = \the\shirazu@titlespace, REST = \the\shirazu@rest}
    \sbox{\shirazu@spinebox}{\color{BlueGray}{\shirazu@spine{\truncate{\shirazu@titlespace}{\PersianThesisTitle}}}}
    \rotatebox{90}{\contour{BlueGray}{\usebox{\shirazu@spinebox}}}
}

%% کامندهای مربوط به اطلاعات پایان نامه
\newcommand{\shirazu@pair}[1]{\csdef{#1}##1##2{\csdef{Persian#1}{##1}\csdef{Latin#1}{##2}}}
\forcsvlist{\shirazu@pair}{StudentName,University,School,Department,FieldOfStudy,ThesisTitle,ThesisYear,ThesisMonth,ThesisGrade,ThesisType,DefenseDate}

\newcommand{\StudentNumber}[1]{\def\theStudentNumber{#1}}
\newcommand{\Degree}[3]{\def\PersianDegree{#1}\def\LatinDegree{#2}\def\LatinDegreeAbbr{#3}}

\newcommand{\shirazu@push}[2]{\ifcsempty{#1}{\csgdef{#1}{#2}}{\csgappto{#1}{,#2}}}
\newcommand{\shirazu@declarefield}[2]{
    \csgdef{Persian#1#2List}{}
    \csgdef{Latin#1#2List}{}
    \csdef{#1#2}##1##2{
        \shirazu@push{Persian#1#2List}{##1}
        \shirazu@push{Latin#1#2List}{##2}
    }
}
\newcommand{\shirazu@declarerole}[2]{
    \shirazu@declarefield{#1}{}
    \forcsvlist{\shirazu@declarefield{#1}}{#2}
}

\shirazu@declarerole{Supervisor}{Title,Department}
\shirazu@declarerole{Advisor}{Title,Department}
\shirazu@declarerole{Examiner}{Title,Department}
\shirazu@declarerole{ExternalExaminer}{Title,Department,University}

\csgdef{LatinSupervisorAbbrList}{}
\let\shirazu@Supervisor\Supervisor
\renewcommand{\Supervisor}[3]{
    \shirazu@Supervisor{#1}{#2}
    \shirazu@push{LatinSupervisorAbbrList}{#3}
}

\newcount{\shirazu@n}
\newcount{\shirazu@i}

\newcommand{\shirazu@count}[1]{%
    \expandafter\let\expandafter\shirazu@list\csname #1\endcsname
    \shirazu@n=0
    \def\do##1{\advance\shirazu@n 1}%
    \expandafter\docsvlist\expandafter{\shirazu@list}%
    \edef\shirazu@total{\the\shirazu@n}%
}
\newcommand{\shirazu@nth}[2]{
    \expandafter\let\expandafter\shirazu@list\csname #1\endcsname
    \def\shirazu@item{}
    \shirazu@n=0
    \def\do##1{
        \advance\shirazu@n 1
        \ifnum\shirazu@n=#2 \def\shirazu@item{##1} \fi
    }
    \expandafter\docsvlist\expandafter{\shirazu@list}
}

\newcommand{\shirazu@names}[2]{\expandafter\forcsvlist\expandafter#1\expandafter{#2}}
\newcommand{\shirazu@name@Persian}[1]{#1\\}
\newcommand{\shirazu@name@Latin}[1]{#1~(Ph.D.)\\}

\newcommand{\PrintPersianSupervisorsName}{\shirazu@names{\shirazu@name@Persian}{\PersianSupervisorList}}
\newcommand{\PrintLatinSupervisorsName}{\shirazu@names{\shirazu@name@Latin}{\LatinSupervisorList}}

\newcommand{\shirazu@get}[2]{\ifcsdef{#1List}{\shirazu@nth{#1List}{#2}}{\def\shirazu@item{}}}
\newcommand{\shirazu@row@Persian}[5]{{#2}، {#3} بخش {#4}\ifblank{#5}{}{،~{#5}} (#1) \dotfill\\}
\newcommand{\shirazu@row@Latin}[5]{\dotfill\; & {#2} (Ph.D.), {#3} of the Dept. of {#4}\ifblank{#5}{}{, {#5}} (#1)\\}
\newcommand{\shirazu@collect}[3]{
    \ifcsdef{#1#2AbbrList}{\shirazu@get{#1#2Abbr}{\the\shirazu@i}}{\shirazu@get{#1#2}{\the\shirazu@i}}
    \let\shirazu@a\shirazu@item
    \shirazu@get{#1#2Title}{\the\shirazu@i}
    \let\shirazu@b\shirazu@item
    \shirazu@get{#1#2Department}{\the\shirazu@i}
    \let\shirazu@c\shirazu@item
    \shirazu@get{#1#2University}{\the\shirazu@i}
    \let\shirazu@d\shirazu@item
    \xappto\shirazu@buf{\expandafter\noexpand\csname shirazu@row@#1\endcsname{#3}{\shirazu@a}{\shirazu@b}{\shirazu@c}{\shirazu@d}}
}

\newcommand{\shirazu@printpeople}[3]{
    \let\shirazu@buf\empty
    \shirazu@count{#1#2List}
    \shirazu@i=0
    \@whilenum\shirazu@i<\shirazu@total\do{
        \advance\shirazu@i 1
        \shirazu@collect{#1}{#2}{#3}
    }
    \shirazu@buf
}

