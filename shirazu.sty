\newcommand{\PrintLatinSupervisors}{\shirazu@printpeople{Latin}{Supervisor}{Supervisor}}
\newcommand{\PrintPersianAdvisors}{\shirazu@printpeople{Persian}{Advisor}{استاد مشاور}}
\newcommand{\PrintLatinAdvisors}{\shirazu@printpeople{Latin}{Advisor}{Advisor}}
