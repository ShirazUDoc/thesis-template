%% دستورات اضافه کردن کلمه فصل به ابتدای شماره فصل در فهرست
\def\@chapter[#1]#2{
    \if@mainmatter
        \refstepcounter{chapter}
        \addcontentsline{toc}{chapter}{\chaptername~\tartibi{chapter}:~#1}
    \else
        \addcontentsline{toc}{chapter}{#1}
    \fi
    \chaptermark{#1}
    \if@twocolumn
        \@topnewpage[\@makechapterhead{#2}]
    \else
        \@makechapterhead{#2}
        \@afterheading
    \fi
}

